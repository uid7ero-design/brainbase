generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organisation {
  id                     String                 @id @default(cuid())
  name                   String
  slug                   String                 @unique
  plan                   Plan                   @default(TRIAL)
  status                 OrgStatus              @default(ACTIVE)
  settings               Json                   @default("{}")
  timezone               String?
  // Phase 4A — Stripe Connect per organisation. See
  // scripts/add-events-payment-connect.sql's header for the full
  // rationale (why direct columns here, not the settings JSON blob or
  // a new table). stripe_account_status's live CHECK constraint is
  // authoritative; this default documents it only.
  stripe_account_id         String?
  stripe_account_status     String                 @default("NOT_CONNECTED")
  stripe_charges_enabled    Boolean                @default(false)
  stripe_payouts_enabled    Boolean                @default(false)
  stripe_details_submitted  Boolean                @default(false)
  stripe_connected_at       DateTime?
  stripe_last_synced_at     DateTime?
  created_at             DateTime               @default(now())
  updated_at             DateTime               @updatedAt
  alerts                 Alert[]
  audit_logs             AuditLog[]
  bin_maintenance_jobs   BinMaintenanceJob[]
  blog_posts             BlogPost[]
  bookings               Booking[]
  booking_recurrence_pauses BookingRecurrencePause[]
  briefings              Briefing[]
  contacts               contacts[]
  contracts              Contract[]
  dashboard_configs      DashboardConfig[]
  debtor_accounts        DebtorAccount[]
  evidence_records       EvidenceRecord[]
  financial_models       FinancialModel[]
  forecasts              Forecast[]
  hlna_actions           HlnaAction[]
  hlna_briefings         HlnaBriefing[]
  hlna_insights          HlnaInsight[]
  illegal_dumping        IllegalDumping[]
  import_batches         ImportBatch[]
  metrics                Metric[]
  missed_collections     MissedCollection[]
  newsletter_subscribers NewsletterSubscriber[]
  saved_views            SavedView[]
  service_requests       ServiceRequest[]
  sessions               Session[]
  session_types          SessionType[]
  tennis_leads           tennis_leads[]
  uploads                Upload[]
  users                  User[]
  sporting_activities    SportingActivity[]
  web_service_leads      WebServiceLead[]
  organisation_modules   OrganisationModule[]
  events                 Event[]

  // stripe_account_id also carries a UNIQUE constraint in the live SQL
  // — a partial index (WHERE NOT NULL), same "Prisma mirrors, raw SQL
  // is authoritative" convention as EventAttendee.ticket_token.
  @@map("organisations")
}

// ─── Capability entitlement (Phase F.4B) ────────────────────────────────
// Module = a customer-facing BrainBase CAPABILITY (crm, organiser, ...),
// never an external integration (Microsoft 365/Google/Instagram remain
// governed entirely by lib/globalIntegrationAccess.ts, untouched here).
// `key` is the durable identity — application code resolves capabilities
// by key, never by an opaque id, so this small, rarely-inserted registry
// deliberately has no separate surrogate id (unlike every business-data
// model in this schema). `active` is the platform-wide kill switch —
// distinct from any organisation's own entitlement, which lives entirely
// in OrganisationModule.enabled below.
// Named PlatformModule (not `Module`) because an unrelated, pre-existing
// `enum Module { WASTE, DUMPING, FORECASTING, ... }` already exists in
// this schema (a waste/local-government dashboard-domain concept, used
// as a field type by 9+ existing models) — this is a Prisma-identifier-
// only collision, resolved by naming the new capability-registry model
// distinctly. The underlying database table name is unaffected: it
// remains `modules` via @@map below, exactly matching the locked SQL
// DDL in scripts/create-modules.sql.
model PlatformModule {
  key         String   @id
  name        String
  description String?
  active      Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  organisation_modules OrganisationModule[]

  @@map("modules")
}

// Per-organisation capability entitlement + behaviour configuration.
// No row = not entitled. enabled = false = not entitled (identical
// effect to a missing row — a row's mere existence never implies
// access). `config` is for module-specific BEHAVIOUR only, never
// integration credential/connection storage. Both foreign keys use
// Restrict (not Cascade) deliberately: organisation/module metadata
// must never disappear implicitly as a side effect of deleting an
// organisation or a module — see scripts/create-organisation-
// modules.sql for the full rationale. `@updatedAt` here is a Prisma-
// Client-side convenience only (matching Organisation's own existing
// use of it above) — the underlying DDL has no database trigger, since
// every write in this repository goes through the raw SQL client
// (lib/db.ts), not Prisma Client.
model OrganisationModule {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  organisation_id String
  module_key      String
  enabled         Boolean  @default(false)
  config          Json     @default("{}")
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)

  organisation Organisation   @relation(fields: [organisation_id], references: [id], onDelete: Restrict)
  module       PlatformModule @relation(fields: [module_key], references: [key], onDelete: Restrict)

  @@unique([organisation_id, module_key])
  @@map("organisation_modules")
}

model User {
  id                String            @id @default(cuid())
  organisation_id   String
  username          String            @unique
  email             String?           @unique
  name              String
  role              UserRole          @default(VIEWER)
  status            UserStatus        @default(ACTIVE)
  last_login_at     DateTime?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  password          String?
  password_hash     String?
  email_verified    Boolean           @default(true)
  audit_logs        AuditLog[]
  briefings         Briefing[]
  dashboard_configs DashboardConfig[]
  import_batches    ImportBatch[]
  saved_views       SavedView[]
  uploads           Upload[]
  confirmed_uploads Upload[]          @relation("UploadConfirmedBy")
  events_created    Event[]
  event_attendees_checked_in EventAttendee[]
  organisation      Organisation      @relation(fields: [organisation_id], references: [id], onDelete: Cascade)

  @@index([organisation_id])
  @@map("users")
}

// Data Hub 5A.2C — canonical durable ingestion lineage: one physical
// uploaded file / storage-and-inspection event. Deliberately does NOT
// become the new home for worksheet-level meaning — the existing Upload
// model gains additive, nullable canonical fields instead (see below),
// so Upload's seven existing domain FK relations (Metric, IllegalDumping,
// MissedCollection, DebtorAccount, ServiceRequest, HlnaInsight,
// EvidenceRecord) keep pointing at valid Upload rows — canonical or
// legacy — with zero schema change to any of those seven relations.
// See docs/architecture/decisions/0001-data-hub-ingestion-foundation.md.
//
// organisation_id deliberately has NO onDelete (Postgres default: NO
// ACTION) — NOT Cascade, unlike Upload.organisation_id below. This row
// anchors a durable external Blob object via storage_key; a synchronous
// Cascade on organisation deletion would hard-delete this row (and lose
// storage_key) before any tombstone-first Blob-cleanup step could run,
// permanently orphaning the object with no way to find it again. This
// matches implementations.organisation_id's existing NO ACTION
// convention (scripts/create-implementations.sql) for the same reason:
// deleting an organisation that still has external-resource lineage
// attached must fail loudly, not silently cascade it away.
model ImportBatch {
  id                      String    @id @default(cuid())
  organisation_id         String
  uploaded_by             String?
  original_filename       String
  content_type            String
  size_bytes              Int
  // Server-computed, authoritative. Never accepted from a client.
  // NULLABLE (5A.2C-R1): under the direct browser-to-private-Blob
  // protocol (initiate -> create pending ImportBatch -> browser uploads
  // -> finalize -> server retrieves bytes -> hash computed), this is
  // genuinely unknown at batch creation (AWAITING_UPLOAD/PROCESSING).
  // The one truthful invariant — status = 'READY' requires a non-NULL
  // sha256 — is enforced by a SQL CHECK constraint
  // (import_batches_ready_requires_sha256 in
  // scripts/create-import-batches.sql) that Prisma cannot express
  // directly in this Prisma version; do not weaken the SQL to compensate
  // for that — the constraint is the actual enforcement, this comment is
  // documentation only.
  sha256                  String?
  storage_provider        String
  // Immutable, server-generated. Never client-controlled. See ADR.
  storage_key             String    @unique
  storage_etag            String?
  // AWAITING_UPLOAD | PROCESSING | READY | FAILED | DELETION_PENDING.
  // Physical-file/storage/inspection lifecycle ONLY — worksheet-level
  // aggregate outcomes (partial/complete) are derived from child Upload
  // rows at read time, never stored here. size_bytes >= 0 is also a
  // SQL-only CHECK (import_batches_size_bytes_check) for the same reason.
  //
  // READY SEMANTICS (5A.2G.0) — READY means ONLY that the physical
  // source file has completed the Data Hub physical finalization stage
  // (durably stored in Blob, authoritative sha256 computed and recorded
  // — see import_batches_ready_requires_sha256 above).
  //
  // READY does NOT mean: worksheet contents have been parsed; worksheet
  // contents have been validated; XLSX content is trusted; it is
  // automatically safe to call XLSX.read (or any equivalent parser entry
  // point) against this file. Parsing an untrusted archive is a distinct,
  // separately-guarded operation — see
  // docs/architecture/decisions/0001-data-hub-ingestion-foundation.md,
  // Section 8 ("Security limitation — explicitly not solved here") and
  // Section 8a ("Decompression boundary implemented (5A.2D)").
  status                  String    @default("AWAITING_UPLOAD")
  // Tenant-scoped start-upload idempotency (see @@unique below). NULL for
  // a request that didn't supply one — many NULLs per tenant are allowed.
  idempotency_key         String?
  // Client-declared, NON-authoritative — a hint only, never trusted for
  // integrity. `sha256` above is the sole server-computed authoritative
  // value; these two fields must never be confused for one another.
  expected_sha256         String?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt
  // Tombstone lifecycle support (delete/cron behaviour implemented later,
  // not in this slice) — deletedAt marks intent-to-delete and blocks new
  // confirmations; storage_deletion_status/storage_deleted_at track the
  // separate, possibly-retried Blob-side deletion outcome so storage_key
  // is retained until that succeeds.
  deleted_at              DateTime?
  storage_deletion_status String?
  storage_deleted_at      DateTime?
  // Attempt/failure metadata (5A.2G.0) — added ahead of the 5A.2G.1
  // initiate/finalize service layer so a FAILED batch's retry safety can
  // be durably recorded from day one. Naming/type conventions copied
  // directly from Upload's own analogous fields above. last_attempt_at
  // has no database default (set by application code on each attempt).
  // attempt_count defaults to 0 so every pre-existing/new row starts
  // coherent with zero backfill. last_failure_code/last_failure_message/
  // last_failure_retryable have no database default and are NULLABLE —
  // whether they are non-NULL is governed by
  // import_batches_failure_retryable_status_check (last_failure_retryable
  // only) below, not by column-level nullability alone. See
  // scripts/create-import-batches.sql for the exact CHECK constraints
  // and the pre-existing-FAILED-row migration-safety backfill they
  // required.
  last_attempt_at         DateTime?
  attempt_count           Int       @default(0)
  last_failure_code       String?
  last_failure_message    String?
  last_failure_retryable  Boolean?

  organisation Organisation @relation(fields: [organisation_id], references: [id])
  uploader     User?        @relation(fields: [uploaded_by], references: [id], onDelete: SetNull)
  uploads      Upload[]

  // Required by canonical Upload's composite tenant-scoped FK — makes it
  // structurally impossible for a worksheet row to reference another
  // tenant's batch.
  @@unique([id, organisation_id])
  @@unique([organisation_id, idempotency_key])
  @@index([organisation_id, created_at])
  @@index([status])
  @@map("import_batches")
}

model Upload {
  id                 String             @id @default(cuid())
  organisation_id    String
  user_id            String?
  original_name      String
  stored_path        String
  mimetype           String
  size_bytes         Int
  schema_type        SchemaType         @default(UNKNOWN)
  module             Module?
  status             UploadStatus       @default(PENDING)
  row_count          Int?
  column_count       Int?
  columns_detected   Json               @default("[]")
  field_mappings     Json               @default("{}")
  validation_errors  Json               @default("[]")
  preview_rows       Json               @default("[]")
  metadata           Json               @default("{}")
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt
  // ── Data Hub 5A.2C canonical worksheet lineage (additive, nullable) ──
  // All NULL/defaulted for every legacy row — zero backfill required.
  // A row with lineage_kind = 'DATA_HUB' is a canonical worksheet within
  // import_batch_id; a legacy row (lineage_kind = 'LEGACY', the default)
  // is entirely unaffected by every field below.
  //
  // Coherence between lineage_kind and import_batch_id/worksheet_index/
  // canonical_status (LEGACY => all three NULL; DATA_HUB => all three
  // NOT NULL) and the two non-negative invariants below (worksheet_index,
  // attempt_count) are enforced by SQL CHECK constraints
  // (uploads_lineage_coherence_check, uploads_worksheet_index_nonneg_check,
  // uploads_attempt_count_nonneg_check in scripts/create-import-batches.sql)
  // that this Prisma version cannot express directly — do not weaken the
  // SQL to compensate; these comments are documentation only, not the
  // enforcement itself.
  import_batch_id       String?
  // Zero-based, authoritative — matches lib/data-hub/workbookParser.ts's
  // decodeWorksheet contract exactly. worksheet_name is descriptive only.
  worksheet_index       Int?
  worksheet_name        String?
  // 'visible' | 'hidden' | 'veryHidden' — parser fact, not policy.
  worksheet_visibility  String?
  worksheet_is_empty    Boolean?
  // 'LEGACY' | 'DATA_HUB' — the discriminator. NOT NULL with a safe
  // default so no row is ever ambiguous about which lineage it belongs to.
  lineage_kind          String             @default("LEGACY")
  // Canonical durable worksheet lifecycle only — deliberately NOT the
  // same vocabulary as the legacy `status` enum above, and deliberately
  // excludes IMPORTING (no durable in-progress state; see ADR/Pass 3).
  // AWAITING_CONFIRMATION | INELIGIBLE | SKIPPED | IMPORTED, or NULL for
  // a legacy row.
  canonical_status      String?
  // Retry/attempt history, kept separate from canonical_status so a
  // pre-transaction validation/mapping failure can never be confused
  // with a partially-committed domain import.
  last_attempt_at       DateTime?
  attempt_count         Int                @default(0)
  last_failure_code     String?
  last_failure_message  String?
  last_failure_retryable Boolean?
  // Data Hub 5A.2L — durable confirmation-actor attribution. Additive,
  // nullable, zero backfill (see scripts/create-import-batches.sql for the
  // full rationale). Set ONCE, together, only by confirmDataHubWorksheet's
  // own atomic conditional claim UPDATE, the first time a DATA_HUB
  // worksheet transitions AWAITING_CONFIRMATION -> IMPORTED. Never set on
  // any failure/loser path, never overwritten on an idempotent repeat
  // confirmation. Distinct from user_id/uploaded_by (uploader lineage) —
  // this is the confirmation EVENT's own actor, not who originally
  // uploaded the physical file.
  confirmed_by          String?
  confirmed_at          DateTime?
  debtor_accounts    DebtorAccount[]
  evidence_records   EvidenceRecord[]
  hlna_insights      HlnaInsight[]
  illegal_dumping    IllegalDumping[]
  metrics            Metric[]
  missed_collections MissedCollection[]
  service_requests   ServiceRequest[]
  organisation       Organisation       @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  user               User?              @relation(fields: [user_id], references: [id])
  // Data Hub 5A.2L — a SECOND, distinct relation to User (confirmation
  // actor, not uploader) — explicitly named to disambiguate from the
  // `user` relation above. Mirrors ImportBatch.uploader's own onDelete:
  // SetNull precedent, not user_id's plain default.
  confirmer          User?              @relation("UploadConfirmedBy", fields: [confirmed_by], references: [id], onDelete: SetNull)
  // Composite tenant-scoped FK — a MATCH SIMPLE constraint, so any row
  // with import_batch_id = NULL (every legacy row) is entirely exempt
  // from this check by Postgres's own FK semantics. For a canonical row
  // (both columns set), this makes it structurally impossible to
  // reference an ImportBatch belonging to a different organisation_id.
  import_batch       ImportBatch?       @relation(fields: [import_batch_id, organisation_id], references: [id, organisation_id])

  @@index([organisation_id])
  @@index([schema_type])
  @@index([status])
  @@index([created_at(sort: Desc)])
  // Canonical worksheet identity. import_batch_id/worksheet_index are
  // NULL on every legacy row, and Postgres's standard UNIQUE semantics
  // treat each NULL as distinct — so all legacy rows coexist under this
  // constraint without conflict; only two genuinely-identical canonical
  // (import_batch_id, worksheet_index) pairs are ever rejected.
  @@unique([import_batch_id, worksheet_index])
  @@map("uploads")
}

model DashboardConfig {
  id              String       @id @default(cuid())
  organisation_id String
  user_id         String?
  name            String
  module          Module
  config          Json         @default("{}")
  is_default      Boolean      @default(false)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  organisation    Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [user_id], references: [id])

  @@index([organisation_id, module])
  @@map("dashboard_configs")
}

model SavedView {
  id              String       @id @default(cuid())
  organisation_id String
  user_id         String?
  module          Module
  name            String
  filters         Json         @default("{}")
  columns         Json         @default("[]")
  sort_field      String?
  sort_direction  String?
  is_shared       Boolean      @default(false)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  organisation    Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [user_id], references: [id])

  @@index([organisation_id, module])
  @@map("saved_views")
}

model Metric {
  id              String       @id @default(cuid())
  organisation_id String
  upload_id       String?
  module          Module
  period_start    DateTime
  period_end      DateTime
  metric_key      String
  metric_value    Float
  unit            String?
  dimension       String?
  dimension_value String?
  metadata        Json         @default("{}")
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  organisation    Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  upload          Upload?      @relation(fields: [upload_id], references: [id])

  @@index([organisation_id, module])
  @@index([organisation_id, metric_key])
  @@index([period_start])
  @@map("metrics")
}

model Forecast {
  id              String            @id @default(cuid())
  organisation_id String
  module          Module
  name            String
  method          ForecastMethod    @default(LINEAR)
  horizon_weeks   Int               @default(12)
  status          ForecastStatus    @default(DRAFT)
  notes           String?
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  versions        ForecastVersion[]
  organisation    Organisation      @relation(fields: [organisation_id], references: [id], onDelete: Cascade)

  @@index([organisation_id, module])
  @@map("forecasts")
}

model ForecastVersion {
  id            String   @id @default(cuid())
  forecast_id   String
  version       Int
  input_data    Json     @default("{}")
  output_data   Json     @default("{}")
  assumptions   Json     @default("{}")
  accuracy_mae  Float?
  accuracy_mape Float?
  created_at    DateTime @default(now())
  forecast      Forecast @relation(fields: [forecast_id], references: [id], onDelete: Cascade)

  @@unique([forecast_id, version])
  @@map("forecast_versions")
}

model FinancialModel {
  id                 String       @id @default(cuid())
  organisation_id    String
  financial_year     String
  forecast_params    Json         @default("{\"multiplier\":1.0,\"as_at_date\":\"\"}")
  line_items         Json         @default("[]")
  rise_and_fall      Json         @default("[]")
  forecast_overrides Json         @default("{}")
  last_edited_by     String?
  locked_at          DateTime?
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt
  organisation       Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)

  @@unique([organisation_id, financial_year])
  @@index([organisation_id])
  @@map("financial_models")
}

model Contract {
  id              String         @id @default(cuid())
  organisation_id String
  supplier        String
  contract_type   String
  description     String?
  start_date      DateTime
  end_date        DateTime
  value           Float
  currency        String         @default("AUD")
  status          ContractStatus @default(ACTIVE)
  auto_renew      Boolean        @default(false)
  notice_days     Int?
  metadata        Json           @default("{}")
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  organisation    Organisation   @relation(fields: [organisation_id], references: [id], onDelete: Cascade)

  @@index([organisation_id])
  @@index([end_date])
  @@map("contracts")
}

model IllegalDumping {
  id              String         @id @default(cuid())
  organisation_id String
  upload_id       String?
  report_date     DateTime
  location        String
  suburb          String?
  zone            String?
  waste_type      String
  volume_estimate String?
  severity        Severity       @default(MEDIUM)
  status          IncidentStatus @default(OPEN)
  crew_assigned   String?
  resolution_date DateTime?
  cost_estimate   Float?
  notes           String?
  metadata        Json           @default("{}")
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  organisation    Organisation   @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  upload          Upload?        @relation(fields: [upload_id], references: [id])

  @@index([organisation_id])
  @@index([status])
  @@index([report_date])
  @@index([suburb])
  @@map("illegal_dumping")
}

model MissedCollection {
  id               String       @id @default(cuid())
  organisation_id  String
  upload_id        String?
  scheduled_date   DateTime
  service_type     String
  route            String?
  zone             String?
  suburb           String?
  address          String
  property_id      String?
  driver_id        String?
  reason           String?
  status           MissedStatus @default(OPEN)
  rescheduled_date DateTime?
  completed_date   DateTime?
  complaint_raised Boolean      @default(false)
  notes            String?
  metadata         Json         @default("{}")
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  organisation     Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  upload           Upload?      @relation(fields: [upload_id], references: [id])

  @@index([organisation_id])
  @@index([status])
  @@index([scheduled_date])
  @@index([route])
  @@index([suburb])
  @@map("missed_collections")
}

model DebtorAccount {
  id                  String       @id @default(cuid())
  organisation_id     String
  upload_id           String?
  account_number      String
  account_name        String
  outstanding_amount  Float
  original_amount     Float?
  days_overdue        Int
  aging_bucket        AgingBucket
  last_payment_date   DateTime?
  last_payment_amount Float?
  status              DebtorStatus @default(OPEN)
  collection_stage    String?
  notes               String?
  metadata            Json         @default("{}")
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt
  organisation        Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  upload              Upload?      @relation(fields: [upload_id], references: [id])

  @@index([organisation_id])
  @@index([aging_bucket])
  @@index([status])
  @@map("debtor_accounts")
}

model ServiceRequest {
  id              String         @id @default(cuid())
  organisation_id String
  upload_id       String?
  request_date    DateTime
  request_type    String
  service_type    String?
  zone            String?
  suburb          String?
  address         String?
  asset_id        String?
  priority        Priority       @default(MEDIUM)
  severity        Severity       @default(MEDIUM)
  status          IncidentStatus @default(OPEN)
  repeat_issue    Boolean        @default(false)
  complaint_count Int            @default(0)
  units_affected  Int?
  response_hours  Float?
  resolution_date DateTime?
  notes           String?
  metadata        Json           @default("{}")
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  organisation    Organisation   @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  upload          Upload?        @relation(fields: [upload_id], references: [id])

  @@index([organisation_id])
  @@index([status])
  @@index([request_date])
  @@index([suburb])
  @@index([service_type])
  @@map("service_requests")
}

model Alert {
  id              String       @id @default(cuid())
  organisation_id String
  module          Module?
  severity        Severity     @default(MEDIUM)
  title           String
