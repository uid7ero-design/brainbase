}

model WebServiceLead {
  id                  String               @id @default(cuid())
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt
  organisation_id     String?
  full_name           String
  business_name       String?
  email               String
  phone               String?
  website_url         String?
  business_type       String?
  service_interest    String[]             @default([])
  budget_range        String?
  project_description String?
  status              WebLeadStatus        @default(NEW)
  source              String?              @default("website")
  notes               String?
  priority            String?              @default("medium")
  score               Int?                 @default(0)
  pipeline_notes      String?
  organisation        Organisation?        @relation(fields: [organisation_id], references: [id], onDelete: SetNull)
  proposals           DeploymentProposal[]
  onboarding          ClientOnboarding[]

  @@index([status])
  @@index([email])
  @@index([created_at(sort: Desc)])
  @@map("web_service_leads")
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  APPROVED
  REJECTED
}

model DeploymentProposal {
  id                String         @id @default(cuid())
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt
  lead_id           String?
  organisation_id   String?
  proposal_title    String         @default("Untitled Proposal")
  proposal_type     String         @default("website_deployment")
  deployment_scope  String?
  monthly_recurring Decimal?       @default(0) @db.Decimal(10, 2)
  one_time_cost     Decimal?       @default(0) @db.Decimal(10, 2)
  status            ProposalStatus @default(DRAFT)
  proposal_content  String?
  included_modules  String[]       @default([])
  notes             String?
  sent_at           DateTime?
  viewed_at         DateTime?
  approved_at       DateTime?
  lead              WebServiceLead? @relation(fields: [lead_id], references: [id], onDelete: SetNull)

  @@index([lead_id])
  @@index([status])
  @@index([created_at(sort: Desc)])
  @@map("deployment_proposals")
}

model ClientOnboarding {
  id                  String         @id @default(cuid())
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt
  organisation_id     String?
  lead_id             String?
  proposal_id         String?
  client_name         String         @default("")
  onboarding_stage    String         @default("discovery")
  assigned_to         String?
  target_launch_date  DateTime?
  hosting_status      String         @default("pending")
  domain_status       String         @default("pending")
  deployment_status   String         @default("not_started")
  integrations_status String         @default("not_started")
  crm_status          String         @default("not_started")
  launch_status       String         @default("not_started")
  checklist           Json           @default("[]")
  notes               String?
  lead                WebServiceLead? @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  managed_service     ManagedService[]

  @@index([onboarding_stage])
  @@index([lead_id])
  @@map("client_onboarding")
}

model ManagedService {
  id                String           @id @default(cuid())
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  organisation_id   String?
  lead_id           String?
  onboarding_id     String?
  client_name       String           @default("")
  hosting_provider  String           @default("vercel")
  domain_provider   String?
  domain_name       String?
  ssl_status        String           @default("active")
  hosting_plan      String           @default("starter")
  maintenance_plan  String           @default("standard")
  monthly_value     Decimal          @default(0) @db.Decimal(10, 2)
  renewal_date      DateTime?
  status            String           @default("active")
  notes             String?
  onboarding        ClientOnboarding? @relation(fields: [onboarding_id], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([created_at(sort: Desc)])
  @@map("managed_services")
}
