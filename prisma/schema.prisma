// ─── Events & Ticketing (Phase 1 — staff-only foundation) ──────────────
// A new, deliberately independent domain — NOT built on the tennis
// Session/SessionInstance/Booking models (those model a recurring weekly
// coaching-class calendar, not a ticketed one-off/multi-date event with
// per-type capacity and pricing tiers) and NOT related to
// BinMaintenanceJob (an unrelated ops-ticket vertical). See the Phase 1
// architecture audit for the full rationale. Written via the raw SQL
// client (lib/db.ts), matching the dominant repository convention for
// general-purpose organisation-scoped domains (auth, organiser, CRM) —
// these Prisma models exist for documentation/type-shape purposes, same
// as Session/Booking/contacts/tennis_leads above.
//
// Phase 1 scope: staff-authenticated management of Event/EventSession/
// EventTicketType only. No public/attendee-facing surface, no
// EventOrder/EventAttendee/EventCheckIn models, no payment processing,
// no QR/check-in, and no audit-log or CRM integration exist yet.
// `price_cents` on EventTicketType is intentionally-unused domain
// preparation only in this phase — a zero price is a fully valid ticket
// type.
//
// Tenant integrity is enforced at the database level, not only in
// application code: Event carries a UNIQUE(id, organisation_id)
// constraint, and both child tables' event relation is a COMPOSITE
// foreign key against (id, organisation_id) rather than a plain
// event_id-only FK — so a session or ticket type physically cannot
// reference an event belonging to a different organisation; the
// database rejects the row outright rather than relying solely on every
// caller remembering to filter by organisation_id.
model Event {
  id              String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  organisation_id String
  name            String
  slug            String
  description     String?
  venue           String?
  // Externally-hosted image URL, not an upload — see
  // scripts/add-events-artwork.sql's header comment for why (no
  // production-grade blob storage is configured in this codebase).
  // Structurally identical to BlogPost.cover_image_url / users.avatar_url.
  artwork_url     String?
  // TEXT with a CHECK constraint in scripts/create-events.sql
  // ('DRAFT'|'PUBLISHED'|'CANCELLED'), not a native Postgres enum type —
  // modelled as a plain String, matching every other raw-SQL-only
  // status-like column in this schema (Booking.status,
  // SessionInstance.status, contacts.status). A genuine Prisma `enum`
  // here would imply a native DB enum type that does not exist; the
  // canonical vocabulary/default contract lives in
  // lib/events/validation.ts's EVENT_STATUSES, which every write path
  // validates against before this column is ever touched.
  status          String            @default("DRAFT")
  starts_at       DateTime          @db.Timestamptz(6)
  ends_at         DateTime          @db.Timestamptz(6)
  timezone        String
  created_by      String?
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @updatedAt @db.Timestamptz(6)

  organisation    Organisation      @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  creator         User?             @relation(fields: [created_by], references: [id], onDelete: SetNull)
  event_sessions  EventSession[]
  ticket_types    EventTicketType[]
  orders          EventOrder[]
  registration_questions EventRegistrationQuestion[]

  // Slug uniqueness is per-organisation only, not global — Phase 1 has
  // no public URL surface that would require a global namespace. If a
  // future public-routing phase resolves events by slug alone (without
  // an organisation segment in the URL), this contract must be
  // revisited before that phase ships.
  @@unique([id, organisation_id])
  @@unique([organisation_id, slug])
  @@index([organisation_id])
  @@index([organisation_id, status])
  @@map("events")
}

model EventSession {
  id              String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  event_id        String
  organisation_id String
  name            String
  starts_at       DateTime     @db.Timestamptz(6)
  ends_at         DateTime     @db.Timestamptz(6)
  capacity        Int
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @updatedAt @db.Timestamptz(6)

  // Composite FK against events(id, organisation_id) — see the Event
  // model's own comment above for why this, not a plain event_id FK.
  event           Event        @relation(fields: [event_id, organisation_id], references: [id, organisation_id], onDelete: Cascade)
  order_items     EventOrderItem[]

  // Phase 2 addition (additive-only, no behavioural change to Phase 1):
  // backs a composite FK from event_order_items(event_session_id,
  // organisation_id) — the same pattern events(id, organisation_id)
  // already uses for event_sessions/event_ticket_types themselves — so a
  // registration physically cannot select a session belonging to a
  // different organisation.
  @@unique([id, organisation_id])
  @@index([event_id])
  @@index([organisation_id])
  @@map("event_sessions")
}

model EventTicketType {
  id              String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  event_id        String
  organisation_id String
  name            String
  description     String?
  price_cents     Int          @default(0)
  // Phase 4 — see scripts/add-events-payments.sql's header for the full
  // rationale (single-currency default, not a multi-currency feature).
  currency        String       @default("AUD")
  capacity        Int
  active           Boolean     @default(true)
  sort_order      Int          @default(0)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @updatedAt @db.Timestamptz(6)

  // Composite FK against events(id, organisation_id) — see the Event
  // model's own comment above for why this, not a plain event_id FK.
  event           Event        @relation(fields: [event_id, organisation_id], references: [id, organisation_id], onDelete: Cascade)
  order_items     EventOrderItem[]

  // Phase 2 addition (additive-only, no behavioural change to Phase 1):
  // backs a composite FK from event_order_items(ticket_type_id,
  // organisation_id) — same rationale as EventSession's own addition
  // above.
  @@unique([id, organisation_id])
  @@index([event_id])
  @@index([organisation_id])
  @@map("event_ticket_types")
}

// ─── Events & Ticketing (Phase 2 — public free registration) ───────────
// Adds only what a free, publicly-submitted registration needs:
// EventOrder (the purchaser + submission), EventOrderItem (which ticket
// type/session and how many), EventAttendee (one row per attendee named
// on the order). Deliberately no QR/token/check-in fields (Phase 3+), no
// payment gateway fields, no email-send bookkeeping.
//
// `status` on EventOrder follows Event.status's own precedent: a plain
// Prisma String backed by TEXT + CHECK in SQL, not a Prisma enum — see
// that model's comment for the full rationale (no native Postgres enum
// type exists for this column).
//
// Tenant integrity extends the exact Phase 1 composite-FK chain:
// events(id, organisation_id) -> event_orders(id, organisation_id) ->
// event_order_items(id, organisation_id) -> event_attendees. Every
// parent/child link in this chain is a composite FK on
// (foreign_id, organisation_id), never a plain foreign_id-only FK, so a
// row anywhere in this chain whose organisation_id doesn't match its
// parent is physically un-insertable at the database level. The one
// exception is denormalized convenience columns (event_id on
// EventOrderItem/EventAttendee, order_id on EventAttendee) — these are
// always derived server-side from an already-tenant-verified chain, and
// mirror Phase 1's own precedent of not additionally FK-enforcing every
// denormalized column beyond the organisation boundary itself.
model EventOrder {
  id              String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  organisation_id String
  event_id        String
  purchaser_name  String
  purchaser_email String
  purchaser_phone String?
  status          String           @default("PENDING")
  // Always 0 for every order the Phase 2 public flow creates — Phase 2
  // is free-only. Exists now so a later paid-orders phase needs no
  // schema change; nothing in Phase 2 ever writes a non-zero value, and
  // the public route independently re-derives (never trusts) pricing
  // from EventTicketType.price_cents server-side.
  total_cents     Int              @default(0)
  // Phase 4 — see scripts/add-events-payments.sql's header for the full
  // rationale of every column below. payment_status follows status's
  // own TEXT + CHECK precedent (see this model's own comment above);
  // its live CHECK constraint is authoritative, this default documents
  // it only.
  payment_status              String    @default("NOT_REQUIRED")
  payment_provider            String?
  stripe_checkout_session_id  String?
  stripe_payment_intent_id    String?
  currency                    String    @default("AUD")
  expires_at                  DateTime? @db.Timestamptz(6)
  paid_at                     DateTime? @db.Timestamptz(6)
  refunded_at                 DateTime? @db.Timestamptz(6)
  // Phase 4A — historical Connect provider attribution. See
  // scripts/add-events-payment-connect.sql's own comment: which
  // connected account actually processed THIS order, independent of
  // the organisation's current Stripe settings.
  stripe_account_id           String?
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @updatedAt @db.Timestamptz(6)

  event           Event            @relation(fields: [event_id, organisation_id], references: [id, organisation_id], onDelete: Cascade)
  order_items     EventOrderItem[]
  registration_responses EventRegistrationResponse[]

  // stripe_checkout_session_id also carries a UNIQUE constraint in the
  // live SQL — a partial index (WHERE NOT NULL), same "Prisma mirrors,
  // raw SQL is authoritative" convention as EventAttendee.ticket_token.
  @@unique([id, organisation_id])
  @@index([organisation_id])
  @@index([event_id])
  @@index([payment_status])
  @@index([stripe_checkout_session_id])
  @@index([stripe_account_id])
  @@map("event_orders")
}

model EventOrderItem {
  id               String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  organisation_id  String
  order_id         String
  event_id         String
  event_session_id String?
  ticket_type_id   String
  quantity         Int
  // Always 0 in Phase 2 — see EventOrder.total_cents's comment.
  unit_price_cents Int             @default(0)
  created_at       DateTime        @default(now()) @db.Timestamptz(6)

  order            EventOrder      @relation(fields: [order_id, organisation_id], references: [id, organisation_id], onDelete: Cascade)
  ticket_type      EventTicketType @relation(fields: [ticket_type_id, organisation_id], references: [id, organisation_id], onDelete: Restrict)
  session          EventSession?   @relation(fields: [event_session_id, organisation_id], references: [id, organisation_id], onDelete: Restrict)
  attendees        EventAttendee[]

  @@unique([id, organisation_id])
  @@index([organisation_id])
  @@index([order_id])
  @@index([ticket_type_id])
  @@index([event_session_id])
  @@map("event_order_items")
}

model EventAttendee {
  id              String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  organisation_id String
  event_id        String
  order_id        String
  order_item_id   String
  attendee_name   String
  attendee_email  String?
  // Phase 3 — see scripts/add-events-ticketing.sql's header comment for
  // the full rationale (nullable, why no separate ticket-status column,
  // 256-bit-entropy generation contract).
  ticket_token          String?
  checked_in_at         DateTime? @db.Timestamptz(6)
  checked_in_by_user_id String?
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime       @updatedAt @db.Timestamptz(6)

  order_item      EventOrderItem @relation(fields: [order_item_id, organisation_id], references: [id, organisation_id], onDelete: Cascade)
  checked_in_by   User?          @relation(fields: [checked_in_by_user_id], references: [id], onDelete: SetNull)
  registration_responses EventRegistrationResponse[]

  // ticket_token also carries a UNIQUE constraint in the live SQL — a
  // partial index (WHERE ticket_token IS NOT NULL, since the column is
  // nullable during backfill), which Prisma's schema DSL cannot express
  // natively. See scripts/add-events-ticketing.sql for the actual
  // CREATE UNIQUE INDEX; this @@index is documentation of the indexed
  // column only, not the full live constraint (same "Prisma mirrors,
  // raw SQL is authoritative" convention this schema already follows
  // for Event.status's CHECK constraint).
  //
  // Phase 4B — id_organisation_id_key is also declared in the live SQL
  // (see scripts/add-events-registration-questions.sql), needed as the
  // composite-FK target for event_registration_responses.attendee_id.
  @@unique([id, organisation_id])
  @@index([ticket_token])
  @@index([organisation_id])
  @@index([event_id])
  @@index([order_id])
  @@index([order_item_id])
  @@index([checked_in_by_user_id])
  @@map("event_attendees")
}

// ─── Events & Ticketing (Phase 4B — configurable registration
// questions / attendee requirements) ────────────────────────────────
// See scripts/add-events-registration-questions.sql's header for the
// full rationale (why a generic question+response model rather than
// fixed columns, why JSONB for options/answer, why snapshot columns).
model EventRegistrationQuestion {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  organisation_id String
  event_id        String
  label           String
  help_text       String?
  field_type      String
  required        Boolean  @default(false)
  scope           String
  options         Json?
  sort_order      Int      @default(0)
  active          Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)

  event           Event    @relation(fields: [event_id, organisation_id], references: [id, organisation_id], onDelete: Cascade)
  responses       EventRegistrationResponse[]

  @@unique([id, organisation_id])
  @@index([organisation_id])
  @@index([event_id])
  @@map("event_registration_questions")
}

model EventRegistrationResponse {
  id                      String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  organisation_id         String
  event_id                String
  question_id             String
  order_id                String
  attendee_id             String?
  question_label_snapshot String
  field_type_snapshot     String
  answer                  Json
  created_at              DateTime @default(now()) @db.Timestamptz(6)

  question                EventRegistrationQuestion @relation(fields: [question_id, organisation_id], references: [id, organisation_id], onDelete: Restrict)
  order                   EventOrder                @relation(fields: [order_id, organisation_id], references: [id, organisation_id], onDelete: Cascade)
  attendee                EventAttendee?             @relation(fields: [attendee_id, organisation_id], references: [id, organisation_id], onDelete: Cascade)

  // The live SQL also carries a partial-composite UNIQUE index on
  // (question_id, order_id, COALESCE(attendee_id, '')) — Prisma's
  // schema DSL cannot express the COALESCE expression natively, same
  // "Prisma mirrors, raw SQL is authoritative" convention as
  // EventAttendee.ticket_token's own partial index.
  @@index([organisation_id])
  @@index([event_id])
  @@index([question_id])
  @@index([order_id])
  @@index([attendee_id])
  @@map("event_registration_responses")
}

