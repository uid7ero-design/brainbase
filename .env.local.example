# ─── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon recommended)
# https://neon.tech — create a project, copy the connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Anthropic Claude API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ─── Voice (ElevenLabs) ────────────────────────────────────────────────────────
# https://elevenlabs.io — create a voice clone or use a built-in voice
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_voice_id

# ─── Cron security ────────────────────────────────────────────────────────────
# Optional — set to any secret string and add to Vercel cron headers
# If unset, the cron endpoint is open (acceptable on Vercel where it's internal-only)
CRON_SECRET=

# ─── Admin bootstrap (Phase 0.5 containment) ──────────────────────────────────
# Required to use POST /api/admin/seed. If unset, that route refuses all
# requests outright (fails closed) rather than relying on the empty-users-table
# check alone. Generate with: openssl rand -hex 32
ADMIN_SEED_SECRET=

# ─── Custom metrics widget SSRF containment (Phase 0.5) ───────────────────────
# Comma-separated hostname allowlist for the /api/metrics widget proxy
# (Sidebar "custom metrics" feature). Exact or subdomain match only — e.g.
# "example.com" also matches "status.example.com" but not "evilexample.com".
# If empty/unset, the route blocks every destination (fails closed).
METRICS_ALLOWED_HOSTS=

# ─── Global-integration temporary containment (Phase 0.5) ─────────────────────
# Gmail, Google Calendar, and Spotify integrations currently share ONE set of
# tokens platform-wide (see lib/gmail/tokens.ts, lib/gcal/tokens.ts,
# lib/spotify/tokens.ts) — there is no per-organisation token storage yet.
# Until that is redesigned, access to each integration is restricted to
# super_admin, or to the single organisation ID configured below. If an env
# var here is left unset, only super_admin can use that integration.
GMAIL_OWNER_ORG_ID=
GCAL_OWNER_ORG_ID=
SPOTIFY_OWNER_ORG_ID=

# ─── Search (Scout agent) ─────────────────────────────────────────────────────
# https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key

# ─── Spotify (optional) ───────────────────────────────────────────────────────
# https://developer.spotify.com/dashboard — create an app
# Add redirect URI: http://localhost:3000/api/spotify/callback
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# ─── Local AI fallback (optional) ─────────────────────────────────────────────
# If ANTHROPIC_API_KEY is unavailable, HLNA falls back to a local Ollama model
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
